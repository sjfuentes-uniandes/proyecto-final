@startuml
title Solventa - Modelo de despliegue (VA-004)

top to bottom direction

skinparam shadowing false
skinparam linetype ortho
skinparam componentStyle uml2
skinparam nodesep 25
skinparam ranksep 55
skinparam ArrowFontSize 12
skinparam ArrowThickness 1
skinparam ArrowColor #455A64

skinparam node {
  BackgroundColor #FFFDF5
  BorderColor #607D8B
  FontColor #263238
}

skinparam artifact {
  BackgroundColor #FFFFFF
  BorderColor #607D8B
  FontColor #263238
}

' =========================================================
' EXPERIENCIAS DE SOLVENTA
' =========================================================

node "Dispositivo del usuario" as DispositivoUsuario <<device>> {
  node "Navegador web" as Navegador <<executionEnvironment>> {
    artifact "Portal de gestión\nde Solventa" as PortalWeb
  }
}

node "Dispositivo móvil" as DispositivoMovil <<device>> {
  node "Sistema operativo móvil" as SistemaMovil <<executionEnvironment>> {
    artifact "Aplicación móvil\nde Solventa" as AplicacionMovil
  }

  node "Almacenamiento local cifrado" as AlmacenMovil <<database>>
}

node "Plataforma del socio\nde distribución" as PlataformaSocio <<externalSystem>> {
  artifact "Canal de venta\ndel socio" as CanalSocio
}

DispositivoUsuario -[hidden]right-> DispositivoMovil
DispositivoMovil -[hidden]right-> PlataformaSocio

' =========================================================
' ACCESO GLOBAL
' =========================================================

node "Acceso global a Solventa" as AccesoGlobal <<cloud>> {
  artifact "Protección y distribución\ndel contenido" as ProteccionGlobal
  artifact "Enrutamiento hacia\nla región disponible" as EnrutamientoGlobal

  ProteccionGlobal --> EnrutamientoGlobal
}

PortalWeb --> ProteccionGlobal : HTTPS
AplicacionMovil --> ProteccionGlobal : HTTPS
CanalSocio --> ProteccionGlobal : HTTPS + mTLS
AplicacionMovil --> AlmacenMovil : modo sin conexión

' =========================================================
' NUBE DE SOLVENTA
' =========================================================

node "Nube de Solventa" as NubeSolventa <<cloud>> {

  ' =======================================================
  ' REGIÓN PRINCIPAL
  ' =======================================================

  node "Región principal\nOperación activa" as RegionPrincipal <<region>> {

    node "Acceso administrado" as AccesoPrincipal <<executionEnvironment>> {
      artifact "Entrada segura\na la plataforma" as EntradaPrincipal
    }

    node "Plataforma de contenedores multi-zona\nRéplicas activas en las zonas A y B" as PlataformaPrincipal <<executionEnvironment>> {

      node "Zona disponible A" as ZonaA <<zone>>
      node "Zona disponible B" as ZonaB <<zone>>

      node "Componentes de acceso" as GrupoAcceso <<grupoDeContenedores>> {
        artifact "Servicios para\nel portal web" as ServiciosWeb
        artifact "Servicios para\nla aplicación móvil" as ServiciosMovil
        artifact "API para socios\nde distribución" as APISocios
      }

      node "Componentes del negocio asegurador" as GrupoNegocio <<grupoDeContenedores>> {
        artifact "Clientes, identidad\ny consentimientos" as ClientesIdentidad
        artifact "Catálogo de seguros\ny reglas del negocio" as CatalogoReglas
        artifact "Perfil de riesgo,\nprecio y cotización" as PerfilCotizacion
        artifact "Suscripción y\ngestión de pólizas" as SuscripcionPolizas
        artifact "Atención de\nsiniestros" as AtencionSiniestros
        artifact "Recaudos e\nindemnizaciones" as RecaudosIndemnizaciones
      }

      node "Componentes de automatización" as GrupoAutomatizacion <<grupoDeContenedores>> {
        artifact "Pagos por eventos\nparamétricos" as PagosParametricos
        artifact "Emisión, avisos\ny conciliación" as EmisionAvisos
        artifact "Actualización masiva de\nperfiles y analítica" as PerfilesAnalitica
      }

      node "Componentes de conexión con aliados" as GrupoConexiones <<grupoDeContenedores>> {
        artifact "Conexión con Finanzas Abiertas\ny Datos Abiertos" as ConexionDatos
        artifact "Verificación de identidad\ny prevención de lavado" as ConexionIdentidad
        artifact "Conexión con medios\nde pago" as ConexionPagos
        artifact "Firma electrónica\ny notificaciones" as ConexionFirma
        artifact "Telemetría, reaseguradoras\ny prestadores" as ConexionOtros
      }
    }

    node "Servicios de información administrados" as InformacionPrincipal <<executionEnvironment>> {
      node "Información de clientes,\nseguros y operaciones" as InformacionNegocio <<database>>
      node "Información de\nconsulta rápida" as InformacionRapida <<cache>>
      node "Evidencias de siniestros" as Evidencias <<objectStore>>
      node "Historial de decisiones\ny uso de datos" as HistorialAuditoria <<immutableStore>>
    }

    node "Mensajería administrada" as MensajeriaPrincipal <<executionEnvironment>> {
      node "Eventos del negocio\nParticionados y durables" as EventosNegocio <<eventStream>>
    }

    node "Operación de Solventa" as OperacionPrincipal <<executionEnvironment>> {
      artifact "Seguimiento de la\noperación de Solventa" as SeguimientoOperacion
      artifact "Control de identidades\ny permisos" as IdentidadesPermisos
      artifact "Protección de claves\ny credenciales" as ClavesCredenciales
      artifact "Entrega automática\nde nuevas versiones" as EntregaVersiones
    }
  }

  ' =======================================================
  ' REGIÓN DE RESPALDO
  ' =======================================================

  node "Región de respaldo\nPreparada para recuperación" as RegionRespaldo <<region>> {

    node "Acceso administrado de respaldo" as AccesoRespaldo <<executionEnvironment>> {
      artifact "Entrada segura\na la plataforma" as EntradaRespaldo
    }

    node "Plataforma de contenedores\ncon capacidad mínima" as PlataformaRespaldo <<executionEnvironment>> {

      artifact "Servicios para el portal web,\nla aplicación móvil y los socios" as AccesoRespaldoApp

      artifact "Clientes, catálogo, perfil de riesgo,\nsuscripción, pólizas, siniestros,\nrecaudos e indemnizaciones" as NegocioRespaldo

      artifact "Pagos paramétricos, emisión,\navisos, conciliación, perfiles\ny analítica" as AutomatizacionRespaldo

      artifact "Conexiones con datos, identidad,\npagos, firma, telemetría,\nreaseguradoras y prestadores" as ConexionesRespaldo
    }

    node "Información replicada" as InformacionRespaldo <<executionEnvironment>> {
      node "Copia de información de clientes,\nseguros y operaciones" as DatosRespaldo <<database>>
      node "Copia de evidencias\nde siniestros" as EvidenciasRespaldo <<objectStore>>
      node "Copia del historial de decisiones\ny uso de datos" as AuditoriaRespaldo <<immutableStore>>
    }

    node "Mensajería replicada" as MensajeriaRespaldo <<executionEnvironment>> {
      node "Copia de eventos\ndel negocio" as EventosRespaldo <<eventStream>>
    }
  }
}

RegionPrincipal -[hidden]down-> RegionRespaldo

' =========================================================
' ALIADOS EXTERNOS
' =========================================================

node "Aliados externos" as AliadosExternos <<externalSystems>> {
  artifact "Finanzas Abiertas\ny Datos Abiertos" as ProveedoresDatos
  artifact "Identidad, KYC\ny AML" as ProveedoresIdentidad
  artifact "Medios de pago" as ProveedoresPago
  artifact "Firma electrónica\ny notificaciones" as ProveedoresFirma
  artifact "Telemetría, reaseguradoras\ny prestadores" as OtrosProveedores
}

' =========================================================
' ENRUTAMIENTO Y ACCESO
' =========================================================

EnrutamientoGlobal --> EntradaPrincipal : región activa
EnrutamientoGlobal ..> EntradaRespaldo : recuperación regional

EntradaPrincipal --> ServiciosWeb
EntradaPrincipal --> ServiciosMovil
EntradaPrincipal --> APISocios

EntradaRespaldo --> AccesoRespaldoApp

' =========================================================
' INTERACCIONES DE LOS COMPONENTES DESPLEGADOS
' =========================================================

ServiciosWeb --> ClientesIdentidad
ServiciosWeb --> SuscripcionPolizas
ServiciosWeb --> AtencionSiniestros

ServiciosMovil --> ClientesIdentidad
ServiciosMovil --> SuscripcionPolizas
ServiciosMovil --> AtencionSiniestros

APISocios --> PerfilCotizacion
APISocios --> SuscripcionPolizas

PerfilCotizacion --> CatalogoReglas
PerfilCotizacion --> ClientesIdentidad
PerfilCotizacion --> SuscripcionPolizas
SuscripcionPolizas --> RecaudosIndemnizaciones
AtencionSiniestros --> RecaudosIndemnizaciones

' =========================================================
' INFORMACIÓN
' =========================================================

ClientesIdentidad --> InformacionNegocio
CatalogoReglas --> InformacionNegocio
PerfilCotizacion --> InformacionNegocio
SuscripcionPolizas --> InformacionNegocio
AtencionSiniestros --> InformacionNegocio
RecaudosIndemnizaciones --> InformacionNegocio

PerfilCotizacion --> InformacionRapida
AtencionSiniestros --> Evidencias

ClientesIdentidad --> HistorialAuditoria
PerfilCotizacion --> HistorialAuditoria
SuscripcionPolizas --> HistorialAuditoria
AtencionSiniestros --> HistorialAuditoria
RecaudosIndemnizaciones --> HistorialAuditoria

' =========================================================
' EVENTOS Y AUTOMATIZACIÓN
' =========================================================

SuscripcionPolizas --> EventosNegocio
AtencionSiniestros --> EventosNegocio
RecaudosIndemnizaciones --> EventosNegocio
ConexionOtros --> EventosNegocio

EventosNegocio --> PagosParametricos
EventosNegocio --> EmisionAvisos
EventosNegocio --> PerfilesAnalitica

PagosParametricos --> AtencionSiniestros
EmisionAvisos --> ConexionFirma

' =========================================================
' INTEGRACIONES EXTERNAS
' =========================================================

ClientesIdentidad --> ConexionDatos
ClientesIdentidad --> ConexionIdentidad
PerfilCotizacion --> ConexionDatos
RecaudosIndemnizaciones --> ConexionPagos
SuscripcionPolizas --> ConexionFirma
AtencionSiniestros --> ConexionOtros

ConexionDatos --> ProveedoresDatos : conexión controlada
ConexionIdentidad --> ProveedoresIdentidad : conexión controlada
ConexionPagos --> ProveedoresPago : conexión controlada
ConexionFirma --> ProveedoresFirma : conexión controlada
ConexionOtros --> OtrosProveedores : conexión controlada

' =========================================================
' OPERACIÓN, SEGURIDAD Y ENTREGA
' =========================================================

EntradaPrincipal ..> IdentidadesPermisos
PlataformaPrincipal ..> ClavesCredenciales
EntradaRespaldo ..> IdentidadesPermisos
PlataformaRespaldo ..> ClavesCredenciales

EntradaPrincipal ..> SeguimientoOperacion
PlataformaPrincipal ..> SeguimientoOperacion
MensajeriaPrincipal ..> SeguimientoOperacion
InformacionPrincipal ..> SeguimientoOperacion
GrupoConexiones ..> SeguimientoOperacion

EntregaVersiones ..> PlataformaPrincipal : despliegue gradual
EntregaVersiones ..> PlataformaRespaldo : misma versión validada

' =========================================================
' REPLICACIÓN Y RECUPERACIÓN
' =========================================================

InformacionNegocio ==> DatosRespaldo : réplica cifrada\nRPO <= 30 segundos
Evidencias ==> EvidenciasRespaldo : réplica cifrada
HistorialAuditoria ==> AuditoriaRespaldo : réplica inmutable
EventosNegocio ==> EventosRespaldo : réplica y reprocesamiento

DatosRespaldo --> NegocioRespaldo
EventosRespaldo --> AutomatizacionRespaldo
EvidenciasRespaldo --> NegocioRespaldo
AuditoriaRespaldo --> NegocioRespaldo

legend bottom
  |= Elemento UML |= Uso en Solventa |
  | Artefacto | Componente desplegable |
  | Entorno de ejecución | Plataforma que ejecuta componentes |
  | Base de datos / caché / almacenamiento | Repositorio del modelo de componentes |
  | Flujo continuo | Comunicación operativa |
  | Flujo discontinuo | Seguridad, observabilidad o recuperación |
  | Flecha doble | Replicación entre regiones |
endlegend

@enduml
