quotation_replicas = 1
task_cpu = 1024
task_memory = 2048
db_pool_size = 8
seed_command = ["python", "-m", "app.seed", "--dataset", "synthetic-v1"]
# Publicar primero las cuatro imágenes y crear images.auto.tfvars.json.
# image_digests debe contener cotizacion, consulta, catalogo y simulador.
# base_state_path = "/ruta/absoluta/infra/base/terraform.tfstate"

quotation_autoscaling_enabled = true
quotation_max_replicas = 3
quotation_cpu_target = 40

# consulta, catalogo y simulador: sin esto quedan fijos en 1 réplica aunque
# cotización escale, y simulador en particular puede volverse el cuello de
# botella compartido (ver EXP-ESC-01 auto-002).
backend_autoscaling_enabled = true
backend_max_replicas = 3
backend_cpu_target = 50
